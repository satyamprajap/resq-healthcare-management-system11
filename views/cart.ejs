<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RESQ - Your Cart</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        background: #f5f8fc;
        color: #333;
      }

      .page-wrapper {
        width: 100%;
        min-height: 100vh;
      }

      .cart-section {
        padding: 100px 20px 60px;
      }

      .container {
        max-width: 1150px;
        margin: auto;
      }

      /* Heading */
      .section-title {
        text-align: center;
        margin-bottom: 40px;
      }

      .section-title h2 {
        font-size: 36px;
        color: #16324f;
        margin-bottom: 12px;
      }

      .section-title p {
        color: #777;
        font-size: 16px;
      }

      /* Coming Soon Banner */
      .coming-soon {
        display: flex;
        align-items: center;
        gap: 20px;
        background: #ef476f;
        color: white;
        padding: 30px;
        border-radius: 10px;
        margin-bottom: 35px;
      }

      .banner-icon {
        font-size: 45px;
      }

      .banner-content h3 {
        font-size: 23px;
        margin-bottom: 12px;
      }

      .banner-content p {
        font-size: 15px;
        line-height: 1.7;
      }

      /* Empty Cart */
      .cart-content {
        text-align: center;
        background: white;
        padding: 50px 20px;
        border-radius: 10px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.05);
      }

      .cart-icon {
        font-size: 65px;
        margin-bottom: 20px;
      }

      .cart-content h3 {
        font-size: 25px;
        color: #16324f;
        margin-bottom: 12px;
      }

      .cart-content p {
        color: #777;
        margin-bottom: 25px;
        line-height: 1.7;
      }

      .home-btn {
        display: inline-block;
        padding: 13px 28px;
        background: #ef476f;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        transition: 0.3s;
      }

      .home-btn:hover {
        background: #16324f;
      }

      /* Features */
      .features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 35px;
      }

      .feature-card {
        background: white;
        text-align: center;
        padding: 25px 15px;
        border-radius: 10px;
        border: 1px solid #eee;
        transition: 0.3s;
      }

      .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
      }

      .feature-icon {
        font-size: 38px;
        margin-bottom: 12px;
      }

      .feature-card h4 {
        color: #16324f;
        margin-bottom: 10px;
      }

      .feature-card p {
        color: #777;
        font-size: 14px;
        line-height: 1.6;
      }

      /* Responsive */
      @media (max-width: 768px) {
        .cart-section {
          padding: 70px 15px 40px;
        }

        .section-title h2 {
          font-size: 29px;
        }

        .coming-soon {
          flex-direction: column;
          text-align: center;
        }

        .features {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <div class="page-wrapper">
      <section class="cart-section">
        <div class="container">
          <!-- Page Heading -->
          <div class="section-title">
            <h2>Your Cart</h2>
            <p>Meds and health products with delivery in under 20 minutes</p>
          </div>

          <!-- Coming Soon Banner -->
          <div class="coming-soon">
            <div class="banner-icon">🚧</div>

            <div class="banner-content">
              <h3>Our Shop is Under Construction</h3>
              <p>
                We're working on launching our medicine delivery service that
                will bring medications to your doorstep in under 20 minutes!
              </p>
            </div>
          </div>

          <!-- Empty Cart -->
          <div class="cart-content">
            <div class="cart-icon">🛒</div>

            <h3>Your Cart is Empty</h3>

            <p>
              Our online medicine shop is launching soon. Stay connected with
              RESQ Healthcare!
            </p>

            <a href="/" class="home-btn"> ← Back to Home </a>
          </div>

          <!-- Features -->
          <div class="features">
            <div class="feature-card">
              <div class="feature-icon">💊</div>
              <h4>Quality Medicines</h4>
              <p>Healthcare products you can trust.</p>
            </div>

            <div class="feature-card">
              <div class="feature-icon">🚑</div>
              <h4>Fast Delivery</h4>
              <p>Our target is delivery in under 20 minutes.</p>
            </div>

            <div class="feature-card">
              <div class="feature-icon">❤️</div>
              <h4>Patient Care</h4>
              <p>Your health and safety come first.</p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        console.log("RESQ Cart Page Loaded Successfully!");
      });
    </script>
  </body>
</html>
